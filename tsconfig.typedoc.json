{
    "extends": "./tsconfig-base.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "baseUrl": ".",
        "paths": {
            "@itowns/geographic": ["packages/Geographic/src/index.ts"],
            "itowns": ["packages/Main/src/Main.js"],
            "Core/*": ["packages/Main/src/Core/*"],
            "Controls/*": ["packages/Main/src/Controls/*"],
            "Converter/*": ["packages/Main/src/Converter/*"],
            "Layer/*": ["packages/Main/src/Layer/*"],
            "Loader/*": ["packages/Main/src/Loader/*"],
            "Parser/*": ["packages/Main/src/Parser/*"],
            "Process/*": ["packages/Main/src/Process/*"],
            "Provider/*": ["packages/Main/src/Provider/*"],
            "Renderer/*": ["packages/Main/src/Renderer/*"],
            "Source/*": ["packages/Main/src/Source/*"],
            "Utils/*": ["packages/Main/src/Utils/*"],
            "Worker/*": ["packages/Main/src/Worker/*"],
            "Main": ["packages/Main/src/Main.js"]
        }
    },
    "include": [
        "packages/Geographic/src/**/*",
        "packages/Main/src/**/*",
        "packages/Debug/src/**/*",
        "packages/Widgets/src/**/*"
    ]
}
